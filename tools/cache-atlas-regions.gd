extends SceneTree
## Rebuild after replacing an atlas. Thresholds/cuts preserve existing artwork.
const SPECS: Array = [
    ["frontier-atlas-v1.png", 4, [0.0, 0.219, 0.488, 0.727, 1.0], 0.25],
    ["frontier-walk-v1.png", 4, [0.0, 0.355, 0.655, 1.0], 0.25],
    ["frontier-passengers-v2.png", 8, [0.0, 0.36, 0.70, 1.0], 0.25],
    ["frontier-props-v1.png", 3, [0.0, 0.22, 0.59, 1.0], 0.25],
    ["frontier-hazards-v1.png", 3, [0.0, 0.34, 0.637, 1.0], 0.25],
    ["frontier-effects-v1.png", 4, [0.0, 0.5, 1.0], 0.04],
    ["frontier-damage-v1.png", 2, [0.0, 0.258, 0.495, 0.74, 1.0], 0.25],
    ["frontier-accidents-v1.png", 2, [0.0, 0.5, 1.0], 0.15],
    ["frontier-upgrade-dock-v1.png", 1, [0.0, 1.0], 0.25]
]

func _initialize() -> void:
    var output: String = "extends RefCounted\n## Generated by tools/cache-atlas-regions.gd. Rebuild after changing an atlas.\nconst REGIONS: Dictionary = {\n"
    var hashes: String = "const SOURCE_HASHES: Dictionary = {\n"
    for spec in SPECS:
        var path: String = "res://assets/sprites/" + str(spec[0])
        var source: Image = Image.load_from_file(ProjectSettings.globalize_path(path))
        hashes += "    \"%s\": \"%s\",\n" % [path, FileAccess.get_sha256(path)]
        var columns: int = int(spec[1])
        var cuts: Array = spec[2]
        output += "    \"%s\": [\n" % path
        for row in range(cuts.size() - 1):
            for column in range(columns):
                var low := Vector2i(column * source.get_width() / columns, int(cuts[row] * source.get_height()))
                var high := Vector2i((column + 1) * source.get_width() / columns, int(cuts[row + 1] * source.get_height()))
                var minimum: Vector2i = high
                var maximum: Vector2i = low - Vector2i.ONE
                for y in range(low.y, high.y):
                    for x in range(low.x, high.x):
                        if source.get_pixel(x, y).a >= float(spec[3]):
                            minimum.x = mini(minimum.x, x)
                            minimum.y = mini(minimum.y, y)
                            maximum.x = maxi(maximum.x, x)
                            maximum.y = maxi(maximum.y, y)
                output += "        Rect2i(%d, %d, %d, %d),\n" % [minimum.x, minimum.y, maximum.x - minimum.x + 1, maximum.y - minimum.y + 1]
        output += "    ],\n"
        print("Cached atlas bounds: ", spec[0])
    output += "}\n\n" + hashes + "}\n\nstatic func frames_for(atlas: Texture2D) -> Array[Texture2D]:\n    var frames: Array[Texture2D] = []\n    for region in REGIONS[atlas.resource_path]:\n        var texture := AtlasTexture.new()\n        texture.atlas = atlas\n        texture.region = Rect2(region)\n        texture.filter_clip = true\n        frames.append(texture)\n    return frames\n"
    var file := FileAccess.open("res://scripts/atlas_regions.gd", FileAccess.WRITE)
    file.store_string(output)
    quit()
